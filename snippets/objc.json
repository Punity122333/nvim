{
  "class_interface": {
    "prefix": ["cls"],
    "description": "Objective-C class interface with properties",
    "body": [
      "@interface ${1:UserProfile} : NSObject",
      "",
      "@property (nonatomic, copy) NSString *displayName;",
      "@property (nonatomic, strong) NSNumber *identifier;",
      "@property (nonatomic, weak) id delegate;",
      "",
      "- (void)refreshFromServer;",
      "",
      "@end"
    ]
  },

  "class_implementation": {
    "prefix": ["clsimpl"],
    "description": "Objective-C class implementation with an instance method",
    "body": [
      "@implementation UserProfile",
      "",
      "- (instancetype)init {",
      "  self = [super init];",
      "  if (self) {",
      "    _identifier = @0;",
      "    _displayName = @\"anonymous\";",
      "  }",
      "  return self;",
      "}",
      "",
      "- (void)refreshFromServer {",
      "  NSLog(@\"refreshing profile %@\", self.displayName);",
      "}",
      "",
      "@end"
    ]
  },

  "property": {
    "prefix": ["prop"],
    "description": "Property declarations with strong, weak, copy and readonly",
    "body": [
      "@property (nonatomic, strong) NSString *title;",
      "@property (nonatomic, copy) NSString *subtitle;",
      "@property (nonatomic, weak) id delegate;",
      "@property (nonatomic, assign) NSInteger tag;",
      "@property (nonatomic, strong, readonly) NSDate *createdAt;"
    ]
  },

  "class_method": {
    "prefix": ["classmethod"],
    "description": "Class method working on the class instead of an instance",
    "body": [
      "+ (NSString *)defaultProfileName {",
      "  return @\"default\";",
      "}",
      "",
      "+ (BOOL)isProfileValid:(UserProfile *)profile {",
      "  return profile.displayName.length > 0;",
      "}"
    ]
  },

  "convenience_constructor": {
    "prefix": ["initwith"],
    "description": "Convenience constructor initialising several properties",
    "body": [
      "- (instancetype)initWithIdentifier:(NSNumber *)identifier",
      "  displayName:(NSString *)displayName {",
      "  self = [super init];",
      "  if (self) {",
      "    _identifier = identifier;",
      "    _displayName = [displayName copy];",
      "  }",
      "  return self;",
      "}"
    ]
  },

  "protocol": {
    "prefix": ["proto"],
    "description": "Protocol with required and optional methods",
    "body": [
      "@protocol UserProfileRefreshing <NSObject>",
      "",
      "@required",
      "- (void)reloadProfile;",
      "",
      "@optional",
      "- (void)reloadProfileWithCompletion:(void (^)(BOOL success))completion;",
      "",
      "@end"
    ]
  },

  "delegate_protocol": {
    "prefix": ["delproto"],
    "description": "Delegate protocol used by a table or a picker view",
