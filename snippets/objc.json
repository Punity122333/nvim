      "@property (nonatomic, copy) void (^onStateChanged)(BOOL isValid);",
      "",
      "- (void)validateWithCompletion:(void (^)(BOOL valid, NSError *error))completion {",
      "  BOOL valid = self.displayName.length > 0;",
