  "notification": {
    "prefix": ["notif"],
    "description": "Registering and handling a notification centre message",
    "body": [
      "- (void)registerForNotifications {",
      "  NSNotificationCenter *center = [NSNotificationCenter defaultCenter];",
      "  [center addObserver:self",
      "      selector:@selector(handleUserUpdated:)",
      "      name:@\"UserProfileDidUpdateNotification\"",
      "      object:nil];",
      "}",
      "",
      "- (void)handleUserUpdated:(NSNotification *)notification {",
      "  [self refreshFromServer];",
      "}"
    ]
  },

  "key_value_observing": {
    "prefix": ["kvo"],
    "description": "Key value observing with a context and its removal",
    "body": [
      "static void *UserProfileContext = &UserProfileContext;",
      "",
      "[self addObserver:self",
      "    forKeyPath:@\"status\"",
      "    options:NSKeyValueObservingOptionInitial | NSKeyValueObservingOptionNew",
      "    context:&UserProfileContext];",
      "",
      "- (void)observeValueForKeyPath:(NSString *)keyPath",
      "  ofObject:(id)object",
      "  change:(NSDictionary<NSKeyValueChangeKey, id> *)change",
      "  context:(void *)context {",
      "  if (context == &UserProfileContext) {",
      "    NSLog(@\"status changed to %@\", change[NSKeyValueChangeNewKey]);",
      "    return;",
      "  }",
      "  [super observeValueForKeyPath:keyPath ofObject:object change:change context:context];",
      "}"
    ]
  },

  "collection_literals": {
    "prefix": ["literals"],
    "description": "NSArray and NSDictionary literals with their mutable variants",
    "body": [
      "NSArray<NSString *> *names = @[@\"ada\", @\"grace\", @\"alan\"];",
      "NSDictionary<NSString *, NSNumber *> *counts = @{@\"ada\": @42, @\"grace\": @7};",
      "",
      "NSMutableArray *items = [NSMutableArray arrayWithArray:names];",
      "NSMutableDictionary *lookup = [NSMutableDictionary dictionaryWithDictionary:counts];"
    ]
  },

  "grand_central_dispatch": {
    "prefix": ["gcd"],
    "description": "GCD dispatch on a custom queue and on the main queue",
    "body": [
      "dispatch_queue_t worker = dispatch_queue_create(\"com.example.upload\", DISPATCH_QUEUE_SERIAL);",
      "",
      "dispatch_async(worker, ^{",
      "  NSData *payload = [self encodePayload];",
      "  dispatch_async(dispatch_get_main_queue(), ^{",
      "    [self applyPayload:payload];",
      "  });",
      "});",
      "",
      "dispatch_after(",
      "  dispatch_time(DISPATCH_TIME_NOW, 500 * NSEC_PER_MSEC),",
      "  dispatch_get_main_queue(), ^{",
      "    [self hideProgressIndicator];",
      "  });"
    ]
  },

  "thread": {
    "prefix": ["thread"],
    "description": "Background thread created with NSThread",
    "body": [
      "NSThread *worker = [[NSThread alloc] initWithTarget:self",
      "    selector:@selector(runBackgroundTask:)",
      "    object:nil];",
      "worker.name = @\"com.example.worker\";",
      "worker.qualityOfService = NSQualityOfServiceUtility;",
      "[worker start];"
    ]
  },

  "autorelease_pool": {
    "prefix": ["autorelease"],
    "description": "Autorelease pool wrapping a block of temporary objects",
    "body": [
      "@autoreleasepool {",
      "  NSMutableArray<NSString *> *collected = [NSMutableArray array];",
      "  for (NSString *name in self.names) {",
      "    [collected addObject:[name uppercaseString]];",
      "  }",
      "  [self finishWithNames:collected];",
      "}"
    ]
  },

  "singleton": {
    "prefix": ["singleton"],
    "description": "Thread safe singleton created with dispatch_once",
    "body": [
      "+ (instancetype)sharedManager {",
      "  static SessionManager *shared = nil;",
      "  static dispatch_once_t onceToken;",
      "  dispatch_once(&onceToken, ^{",
      "    shared = [[SessionManager alloc] init];",
      "  });",
      "  return shared;",
      "}"
    ]
  },

  "error_handling_block": {
    "prefix": ["errblock"],
    "description": "Error handling with an NSError pointer and a completion block",
    "body": [
      "- (BOOL)saveToDisk:(NSString *)path error:(NSError **)error {",
      "  NSData *data = [self encodePayload];",
      "  if (![data writeToFile:path options:NSDataWritingAtomic error:error]) {",
      "    return NO;",
      "  }",
      "  return YES;",
      "}",
      "",
      "[self saveToDisk:path completion:^(NSError *error) {",
      "  if (error != nil) {",
      "    [self presentError:error];",
      "    return;",
      "  }",
      "  [self didSaveToDisk:path];",
      "}];"
    ]
  }
}
