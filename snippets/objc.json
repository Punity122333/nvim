      "",
      "@end"
    ]
  },

  "category": {
    "prefix": ["cat"],
    "description": "Category declaration together with its implementation",
    "body": [
      "@interface UserProfile (Formatting)",
      "",
      "- (NSString *)debugDescription;",
      "",
      "@end",
      "",
      "@implementation UserProfile (Formatting)",
      "",
      "- (NSString *)debugDescription {",
      "  return [NSString stringWithFormat:@\"<UserProfile %@ id=%@>\",",
      "          self.displayName, self.identifier];",
      "}",
      "",
      "@end"
    ]
  },

