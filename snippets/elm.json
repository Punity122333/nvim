{
  "elm_module": {
    "prefix": ["module"],
    "description": "Elm module header with the exposed names",
    "body": [
      "module ${1:Main} exposing (${2:main})",
      "",
      "import Html exposing (Html, div, text)",
      "",
      "",
      "${2:main} : Html msg",
      "${2:main} =",
      "    div [] [ text \"Hello\" ]"
    ]
  },

  "elm_type_alias": {
    "prefix": ["typealias", "type alias"],
    "description": "Type alias describing a record",
    "body": [
      "type alias ${1:Model} =",
      "    { ${2:count} : Int",
      "    , ${3:message} : String",
      "    }"
    ]
  },

  "elm_custom_type": {
    "prefix": ["type"],
    "description": "Custom type with a few constructors",
    "body": [
      "type ${1:Msg}",
      "    = ${2:Increment}",
      "    | ${3:Decrement}",
      "    | ${4:Reset}"
    ]
  },

  "elm_function": {
    "prefix": ["fn"],
    "description": "Function with a type annotation",
    "body": [
      "${1:add} : Int -> Int -> Int",
      "${1:add} a b =",
      "    a + b"
    ]
  },

  "elm_case": {
    "prefix": ["case"],
    "description": "Case expression with a fallback branch",
    "body": [
      "case ${1:value} of",
      "    ${2:Pattern} ->",
      "        ${3:result}",
      "",
      "    _ ->",
      "        ${4:fallback}"
    ]
  },

  "elm_let": {
    "prefix": ["let"],
    "description": "Let expression binding intermediate values",
    "body": [
      "let",
      "    ${1:name} = ${2:value}",
      "in",
      "${3:name}"
    ]
  },

  "elm_view": {
    "prefix": ["view"],
    "description": "View function rendering the model",
    "body": [
      "view : Model -> Html Msg",
      "view model =",
      "    div []",
      "        [ button [ onClick ${1:Increment} ] [ text \"+\" ]",
      "        , text (String.fromInt model.${2:count})",
      "        ]"
    ]
  },

  "elm_update": {
    "prefix": ["update"],
    "description": "Update function handling the messages",
    "body": [
      "update : Msg -> Model -> Model",
      "update msg model =",
      "    case msg of",
      "        ${1:Increment} ->",
      "            { model | ${2:count} = model.${2:count} + 1 }",
      "",
      "        ${3:Reset} ->",
      "            { model | ${2:count} = 0 }"
    ]
  },

  "elm_record": {
    "prefix": ["record"],
    "description": "Record with a single field",
    "body": [
      "{ ${1:field} : ${2:String} }"
    ]
  },

  "elm_list": {
    "prefix": ["list"],
    "description": "List literal",
    "body": [
      "[ ${1:first}, ${2:second} ]"
    ]
  },

  "elm_dict": {
    "prefix": ["dict"],
    "description": "Dictionary access with a default value",
    "body": [
      "Dict.get ${1:key} ${2:dict} |> Maybe.withDefault ${3:default}"
    ]
  },

  "elm_html_node": {
    "prefix": ["html"],
    "description": "Html node with attributes and children",
    "body": [
      "${1:div} [ ${2:class} \"${3:value}\" ] [ text \"${4:content}\" ]"
    ]
  },

  "elm_port_module": {
    "prefix": ["port"],
    "description": "Port module exposing commands and subscriptions",
    "body": [
      "port module ${1:Ports} exposing (${2:command})",
      "",
      "port ${2:command} : String -> Cmd msg"
    ]
  },

  "elm_init": {
    "prefix": ["init"],
    "description": "Init function returning the model and the commands",
    "body": [
      "init : ( Model, Cmd Msg )",
      "init =",
      "    ( { ${1:count} = 0 }, Cmd.none )"
    ]
  },

  "elm_subscriptions": {
    "prefix": ["subscriptions"],
    "description": "Subscriptions function",
    "body": [
      "subscriptions : Model -> Sub Msg",
      "subscriptions _ =",
      "    Sub.none"
    ]
  }
}
