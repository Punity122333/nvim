{
  "reset": {
    "prefix": "reset",
    "body": [
      "* {",
      "  margin: 0;",
      "  padding: 0;",
      "  box-sizing: border-box;",
      "}"
    ]
  },

  "body_base": {
    "prefix": "body",
    "body": [
      "body {",
      "  font-family: ${1:system-ui, sans-serif};",
      "  line-height: ${2:1.5};",
      "  background: ${3:#f9fafb};",
      "  color: ${4:#111};",
      "}"
    ]
  },

  "flex_center": {
    "prefix": "flexc",
    "body": [
      "display: flex;",
      "justify-content: ${1:center};",
      "align-items: ${2:center};"
    ]
  },

  "grid_center": {
    "prefix": "gridc",
    "body": [
      "display: grid;",
      "place-items: ${1:center};"
    ]
  },

  "container": {
    "prefix": "container",
    "body": [
      "max-width: ${1:1200px};",
      "margin: ${2:0 auto};",
      "padding: ${3:0 16px};"
    ]
  },

  "button_base": {
    "prefix": "btn",
    "body": [
      "padding: ${1:10px} ${2:16px};",
      "border: ${3:none};",
      "border-radius: ${4:8px};",
      "cursor: pointer;",
      "transition: all ${5:0.2s} ease;",
      "font-weight: ${6:500};"
    ]
  },

  "button_primary": {
    "prefix": "btnp",
    "body": [
      "background: ${1:#3b82f6};",
      "color: ${2:white};",
      "",
      ":hover {",
      "  background: ${3:#2563eb};",
      "  transform: translateY(${4:-2px});",
      "}"
    ]
  },

  "button_outline": {
    "prefix": "btno",
    "body": [
      "background: transparent;",
      "border: ${1:2px solid #3b82f6};",
      "color: ${2:#3b82f6};",
      "",
      ":hover {",
      "  background: ${3:#3b82f6};",
      "  color: ${4:white};",
      "}"
    ]
  },

  "card": {
    "prefix": "card",
    "body": [
      "background: ${1:white};",
      "padding: ${2:16px};",
      "border-radius: ${3:12px};",
      "box-shadow: ${4:0 4px 10px rgba(0,0,0,0.08)};"
    ]
  },

  "card_hover": {
    "prefix": "cardh",
    "body": [
      "transition: ${1:0.2s} ease;",
      "",
      ":hover {",
      "  transform: translateY(${2:-4px});",
      "  box-shadow: ${3:0 10px 20px rgba(0,0,0,0.12)};",
      "}"
    ]
  },

  "input": {
    "prefix": "input",
    "body": [
      "padding: ${1:10px} ${2:12px};",
      "border: ${3:1px solid #ccc};",
      "border-radius: ${4:6px};",
      "outline: none;",
      "transition: ${5:0.2s};"
    ]
  },

  "input_focus": {
    "prefix": "focus",
    "body": [
      ":focus {",
      "  border-color: ${1:#3b82f6};",
      "  box-shadow: ${2:0 0 0 3px rgba(59,130,246,0.2)};",
      "}"
    ]
  },

  "navbar": {
    "prefix": "nav",
    "body": [
      ".navbar {",
      "  display: flex;",
      "  justify-content: space-between;",
      "  align-items: center;",
      "  padding: ${1:16px 24px};",
      "  background: ${2:#111};",
      "  color: ${3:white};",
      "}"
    ]
  },

  "navbar_links": {
    "prefix": "navlinks",
    "body": [
      ".navbar ul {",
      "  display: flex;",
      "  gap: ${1:16px};",
      "  list-style: none;",
      "}"
    ]
  },

  "grid_auto": {
    "prefix": "gridauto",
    "body": [
      "display: grid;",
      "grid-template-columns: repeat(auto-fit, minmax(${1:200px}, 1fr));",
      "gap: ${2:16px};"
    ]
  },

  "media_query": {
    "prefix": "media",
    "body": [
      "@media (max-width: ${1:768px}) {",
      "  $2",
      "}"
    ]
  },

  "shadow_sm": {
    "prefix": "shadow",
    "body": ["box-shadow: ${1:0 2px 6px rgba(0,0,0,0.08)};"]
  },

  "shadow_lg": {
    "prefix": "shadowlg",
    "body": ["box-shadow: ${1:0 10px 25px rgba(0,0,0,0.15)};"]
  },

  "glass": {
    "prefix": "glass",
    "body": [
      "background: rgba(255,255,255,${1:0.1});",
      "backdrop-filter: blur(${2:10px});",
      "-webkit-backdrop-filter: blur(${3:10px});",
      "border: 1px solid rgba(255,255,255,${4:0.2});",
      "border-radius: ${5:12px};"
    ]
  },

  "fade_in": {
    "prefix": "fade",
    "body": [
      "@keyframes fadeIn {",
      "  from { opacity: 0; transform: translateY(${1:10px}); }",
      "  to { opacity: 1; transform: translateY(0); }",
      "}",
      "",
      "animation: fadeIn ${2:0.3s} ease forwards;"
    ]
  },

  "slide_in": {
    "prefix": "slide",
    "body": [
      "@keyframes slideIn {",
      "  from { transform: translateX(${1:-20px}); opacity: 0; }",
      "  to { transform: translateX(0); opacity: 1; }",
      "}",
      "",
      "animation: slideIn ${2:0.3s} ease forwards;"
    ]
  },

  "absolute_center": {
    "prefix": "abcenter",
    "body": [
      "position: absolute;",
      "top: ${1:50%};",
      "left: ${2:50%};",
      "transform: translate(-50%, -50%);"
    ]
  },

  "full_screen_center": {
    "prefix": "fullc",
    "body": [
      "display: flex;",
      "justify-content: center;",
      "align-items: center;",
      "height: ${1:100vh};",
      "width: ${2:100vw};"
    ]
  },

  "dashboard_layout": {
    "prefix": "dashboard",
    "body": [
      "display: grid;",
      "grid-template-columns: ${1:240px} 1fr;",
      "height: 100vh;",
      "",
      ".sidebar {",
      "  background: ${2:#111};",
      "  color: ${3:white};",
      "  padding: ${4:20px};",
      "}",
      "",
      ".main {",
      "  background: ${5:#f9fafb};",
      "  padding: ${6:20px};",
      "}"
    ]
  },

  "landing_layout": {
    "prefix": "landing",
    "body": [
      "display: flex;",
      "flex-direction: column;",
      "justify-content: center;",
      "align-items: center;",
      "height: 100vh;",
      "text-align: center;",
      "",
      "h1 { font-size: ${1:48px}; }",
      "p { color: ${2:#666}; }"
    ]
  },

  "theme_variables": {
    "prefix": ["themevars"],
    "description": "Design tokens exposed as CSS custom properties",
    "body": [
      ":root {",
      "  --color-bg: #ffffff;",
      "  --color-surface: #f5f6f8;",
      "  --color-text: #1b1f24;",
      "  --color-muted: #5c6670;",
      "  --color-accent: ${1:#2f6feb};",
      "  --color-border: #d7dce3;",
      "  --radius-sm: 4px;",
      "  --radius-md: 8px;",
      "  --radius-lg: 16px;",
      "  --space-1: 4px;",
      "  --space-2: 8px;",
      "  --space-3: 16px;",
      "  --space-4: 24px;",
      "  --font-body: system-ui, -apple-system, \"Segoe UI\", sans-serif;",
      "  --shadow-card: 0 1px 2px rgba(0, 0, 0, 0.08);",
      "}"
    ]
  },

  "dark_mode": {
    "prefix": ["darkmode"],
    "description": "Dark mode overrides driven by prefers-color-scheme",
    "body": [
      "@media (prefers-color-scheme: dark) {",
      "  :root {",
      "    --color-bg: #14171c;",
      "    --color-surface: #1c2128;",
      "    --color-text: #e6e9ee;",
      "    --color-muted: #9aa4b1;",
      "    --color-accent: #6ea8fe;",
      "    --color-border: #2b313a;",
      "    --shadow-card: 0 1px 2px rgba(0, 0, 0, 0.5);",
      "  }",
      "",
      "  body {",
      "    background: var(--color-bg);",
      "    color: var(--color-text);",
      "  }",
      "",
      "  img {",
      "    filter: brightness(0.9) contrast(1.05);",
      "  }",
      "}"
    ]
  },

  "tooltip": {
    "prefix": ["tooltip"],
    "description": "Tooltip bubble shown on hover and keyboard focus",
    "body": [
      ".tooltip {",
      "  position: relative;",
      "  display: inline-block;",
      "}",
      "",
      ".tooltip::after {",
      "  content: attr(data-tooltip);",
      "  position: absolute;",
      "  bottom: calc(100% + 8px);",
      "  left: 50%;",
      "  transform: translateX(-50%);",
      "  padding: 6px 10px;",
      "  border-radius: 4px;",
      "  background: var(--color-text, #1b1f24);",
      "  color: var(--color-bg, #ffffff);",
      "  font-size: 12px;",
      "  white-space: nowrap;",
      "  opacity: 0;",
      "  pointer-events: none;",
      "  transition: opacity 120ms ease-in-out;",
      "}",
      "",
      ".tooltip:hover::after,",
      ".tooltip:focus-visible::after {",
      "  opacity: 1;",
      "}"
    ]
  },

  "modal_dialog": {
    "prefix": ["modal"],
    "description": "Modal overlay with a centered scrollable panel",
    "body": [
      ".modal {",
      "  position: fixed;",
      "  inset: 0;",
      "  display: grid;",
      "  place-items: center;",
      "  padding: 24px;",
      "  background: rgba(15, 18, 22, 0.55);",
      "  opacity: 0;",
      "  visibility: hidden;",
      "  transition: opacity 160ms ease, visibility 160ms ease;",
      "}",
      "",
      ".modal.is-open {",
      "  opacity: 1;",
      "  visibility: visible;",
      "}",
      "",
      ".modal__panel {",
      "  width: min(520px, 100%);",
      "  max-height: 85vh;",
      "  overflow: auto;",
      "  padding: 24px;",
      "  border-radius: 8px;",
      "  background: var(--color-surface, #ffffff);",
      "  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);",
      "}"
    ]
  },

  "badge": {
    "prefix": ["badge"],
    "description": "Small pill badge with status colour variants",
    "body": [
      ".badge {",
      "  display: inline-flex;",
      "  align-items: center;",
      "  gap: 4px;",
      "  padding: 2px 8px;",
      "  border: 1px solid var(--color-border, #d7dce3);",
      "  border-radius: 999px;",
      "  background: var(--color-surface, #f5f6f8);",
      "  color: var(--color-muted, #5c6670);",
      "  font-size: 12px;",
      "  font-weight: 600;",
      "  line-height: 18px;",
      "}",
      "",
      ".badge--success {",
      "  border-color: #1a7f37;",
      "  background: #dafbe1;",
      "  color: #1a7f37;",
      "}",
      "",
      ".badge--danger {",
      "  border-color: #cf222e;",
      "  background: #ffebe9;",
      "  color: #cf222e;",
      "}"
    ]
  },

  "data_table": {
    "prefix": ["table"],
    "description": "Data table styling with a sticky header row",
    "body": [
      ".table {",
      "  width: 100%;",
      "  border-collapse: collapse;",
      "  font-variant-numeric: tabular-nums;",
      "}",
      "",
      ".table caption {",
      "  padding-bottom: 8px;",
      "  color: var(--color-muted, #5c6670);",
      "  font-size: 13px;",
      "  text-align: left;",
      "}",
      "",
      ".table th,",
      ".table td {",
      "  padding: 8px 12px;",
      "  border-bottom: 1px solid var(--color-border, #d7dce3);",
      "  text-align: left;",
      "}",
      "",
      ".table thead th {",
      "  position: sticky;",
      "  top: 0;",
      "  z-index: 2;",
      "  background: var(--color-surface, #f5f6f8);",
      "  font-size: 12px;",
      "  letter-spacing: 0.04em;",
      "  text-transform: uppercase;",
      "}",
      "",
      ".table tbody tr:hover {",
      "  background: color-mix(in srgb, var(--color-accent, #2f6feb) 8%, transparent);",
      "}"
    ]
  },

  "transition_utility": {
    "prefix": ["transition"],
    "description": "Shared transition timings that respect reduced motion",
    "body": [
      ".transition {",
      "  transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease,",
      "    box-shadow 150ms ease, transform 150ms ease;",
      "}",
      "",
      ".transition-slow {",
      "  transition: all 400ms cubic-bezier(0.4, 0, 0.2, 1);",
      "}",
      "",
      "@media (prefers-reduced-motion: reduce) {",
      "  .transition,",
      "  .transition-slow {",
      "    transition: none;",
      "  }",
      "}"
    ]
  },

  "keyframes_animation": {
    "prefix": ["keyframes"],
    "description": "Reusable keyframes for entrance and loading animations",
    "body": [
      "@keyframes fade-slide-in {",
      "  from {",
      "    opacity: 0;",
      "    transform: translateY(8px);",
      "  }",
      "  to {",
      "    opacity: 1;",
      "    transform: translateY(0);",
      "  }",
      "}",
      "",
      "@keyframes spin {",
      "  to {",
      "    transform: rotate(360deg);",
      "  }",
      "}",
      "",
      ".animate-in {",
      "  animation: fade-slide-in 220ms ease-out both;",
      "}",
      "",
      ".animate-spin {",
      "  animation: spin 900ms linear infinite;",
      "}"
    ]
  },

  "hover_effect": {
    "prefix": ["hoverfx"],
    "description": "Hover effect that lifts an element and deepens its shadow",
    "body": [
      ".hover-lift {",
      "  transition: transform 160ms ease, box-shadow 160ms ease;",
      "}",
      "",
      ".hover-lift:hover,",
      ".hover-lift:focus-within {",
      "  transform: translateY(-2px);",
      "  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);",
      "}",
      "",
      ".hover-lift:active {",
      "  transform: translateY(0);",
      "  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);",
      "}"
    ]
  },

  "utility_classes": {
    "prefix": ["util"],
    "description": "Small single purpose utility classes for layout and text",
    "body": [
      ".u-hidden {",
      "  display: none !important;",
      "}",
      "",
      ".u-truncate {",
      "  overflow: hidden;",
      "  text-overflow: ellipsis;",
      "  white-space: nowrap;",
      "}",
      "",
      ".u-mono {",
      "  font-family: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace;",
      "}",
      "",
      ".u-flex-center {",
      "  display: flex;",
      "  align-items: center;",
      "  justify-content: center;",
      "}",
      "",
      ".u-gap {",
      "  gap: 16px;",
      "}",
      "",
      ".u-text-muted {",
      "  color: var(--color-muted, #5c6670);",
      "}"
    ]
  },

  "line_clamp": {
    "prefix": ["srclamp"],
    "description": "Truncate text to a fixed number of lines",
    "body": [
      ".clamp-2 {",
      "  display: -webkit-box;",
      "  -webkit-line-clamp: 2;",
      "  -webkit-box-orient: vertical;",
      "  overflow: hidden;",
      "}",
      "",
      ".clamp-3 {",
      "  display: -webkit-box;",
      "  -webkit-line-clamp: 3;",
      "  -webkit-box-orient: vertical;",
      "  overflow: hidden;",
      "}"
    ]
  },

  "aspect_ratio_box": {
    "prefix": ["aspect"],
    "description": "Aspect ratio boxes with cropped cover images",
    "body": [
      ".aspect-16-9 {",
      "  aspect-ratio: 16 / 9;",
      "  overflow: hidden;",
      "}",
      "",
      ".aspect-1-1 {",
      "  aspect-ratio: 1 / 1;",
      "  overflow: hidden;",
      "}",
      "",
      ".aspect-box img {",
      "  width: 100%;",
      "  height: 100%;",
      "  object-fit: cover;",
      "}"
    ]
  },

  "custom_scrollbar": {
    "prefix": ["scrollbar"],
    "description": "Slim themed scrollbar for webkit and firefox",
    "body": [
      ".scroll-thin {",
      "  scrollbar-width: thin;",
      "  scrollbar-color: var(--color-border, #d7dce3) transparent;",
      "}",
      "",
      ".scroll-thin::-webkit-scrollbar {",
      "  width: 8px;",
      "  height: 8px;",
      "}",
      "",
      ".scroll-thin::-webkit-scrollbar-track {",
      "  background: transparent;",
      "}",
      "",
      ".scroll-thin::-webkit-scrollbar-thumb {",
      "  background: var(--color-border, #d7dce3);",
      "  border-radius: 999px;",
      "}",
      "",
      ".scroll-thin::-webkit-scrollbar-thumb:hover {",
      "  background: var(--color-muted, #5c6670);",
      "}"
    ]
  },

  "focus_visible": {
    "prefix": ["focusvis"],
    "description": "Visible focus ring applied only for keyboard navigation",
    "body": [
      ":focus-visible {",
      "  outline: 2px solid var(--color-accent, #2f6feb);",
      "  outline-offset: 2px;",
      "}",
      "",
      ".focus-ring-none:focus-visible {",
      "  outline: none;",
      "  box-shadow: 0 0 0 3px rgba(47, 111, 235, 0.35);",
      "}",
      "",
      ".focus-ring-none {",
      "  &:focus-visible {",
      "    outline: none;",
      "  }",
      "}"
    ]
  },

  "form_field": {
    "prefix": ["fieldstyle"],
    "description": "Labelled form field with hint and invalid states",
    "body": [
      ".field {",
      "  display: flex;",
      "  flex-direction: column;",
      "  gap: 6px;",
      "  margin-bottom: 16px;",
      "}",
      "",
      ".field__label {",
      "  font-size: 13px;",
      "  font-weight: 600;",
      "}",
      "",
      ".field__hint {",
      "  font-size: 12px;",
      "  color: var(--color-muted, #5c6670);",
      "}",
      "",
      ".field__input {",
      "  width: 100%;",
      "  padding: 8px 10px;",
      "  border: 1px solid var(--color-border, #d7dce3);",
      "  border-radius: 6px;",
      "  background: var(--color-bg, #ffffff);",
      "  color: inherit;",
      "  font: inherit;",
      "}",
      "",
      ".field__input:focus-visible {",
      "  border-color: var(--color-accent, #2f6feb);",
      "}",
      "",
      ".field__input[aria-invalid=\"true\"] {",
      "  border-color: #cf222e;",
      "}"
    ]
  },

  "custom_checkbox": {
    "prefix": ["checkbox"],
    "description": "Accessible checkbox and radio rows with focus states",
    "body": [
      ".check {",
      "  display: inline-flex;",
      "  align-items: center;",
      "  gap: 8px;",
      "  cursor: pointer;",
      "}",
      "",
      ".check input {",
      "  width: 16px;",
      "  height: 16px;",
      "  accent-color: var(--color-accent, #2f6feb);",
      "  cursor: pointer;",
      "}",
      "",
      ".check input:focus-visible {",
      "  outline: 2px solid var(--color-accent, #2f6feb);",
      "  outline-offset: 2px;",
      "}",
      "",
      ".check--disabled {",
      "  color: var(--color-muted, #5c6670);",
      "  cursor: not-allowed;",
      "}"
    ]
  },

  "print_stylesheet": {
    "prefix": ["printcss"],
    "description": "Print stylesheet that hides chrome and expands link targets",
    "body": [
      "@media print {",
      "  @page {",
      "    margin: 16mm;",
      "  }",
      "",
      "  body {",
      "    background: #ffffff;",
      "    color: #000000;",
      "    font-size: 11pt;",
      "  }",
      "",
      "  .no-print,",
      "  nav,",
      "  footer {",
      "    display: none !important;",
      "  }",
      "",
      "  a[href^=\"http\"]::after {",
      "    content: \" (\" attr(href) \")\";",
      "    color: #444444;",
      "    font-size: 9pt;",
      "  }",
      "",
      "  table {",
      "    width: 100%;",
      "    border-collapse: collapse;",
      "  }",
      "",
      "  th,",
      "  td {",
      "    padding: 4pt;",
      "    border: 1px solid #999999;",
      "  }",
      "}"
    ]
  },

  "grid_template_areas": {
    "prefix": ["gridarea"],
    "description": "Page grid built from named template areas",
    "body": [
      ".layout {",
      "  display: grid;",
      "  grid-template-areas:",
      "    \"header header\"",
      "    \"sidebar main\"",
      "    \"footer footer\";",
      "  grid-template-columns: 240px 1fr;",
      "  grid-template-rows: auto 1fr auto;",
      "  gap: 16px;",
      "}",
      "",
      ".layout__header {",
      "  grid-area: header;",
      "}",
      "",
      ".layout__sidebar {",
      "  grid-area: sidebar;",
      "}",
      "",
      ".layout__main {",
      "  grid-area: main;",
      "}",
      "",
      ".layout__footer {",
      "  grid-area: footer;",
      "}"
    ]
  },

  "card_component": {
    "prefix": ["cardstyle"],
    "description": "Card component with title, body and footer sections",
    "body": [
      ".card {",
      "  display: flex;",
      "  flex-direction: column;",
      "  gap: 12px;",
      "  padding: 20px;",
      "  border: 1px solid var(--color-border, #d7dce3);",
      "  border-radius: 12px;",
      "  background: var(--color-surface, #ffffff);",
      "  box-shadow: var(--shadow-card, 0 1px 2px rgba(0, 0, 0, 0.08));",
      "}",
      "",
      ".card__title {",
      "  margin: 0;",
      "  font-size: 18px;",
      "  font-weight: 600;",
      "}",
      "",
      ".card__body {",
      "  margin: 0;",
      "  color: var(--color-muted, #5c6670);",
      "  font-size: 14px;",
      "  line-height: 1.5;",
      "}",
      "",
      ".card__footer {",
      "  display: flex;",
      "  align-items: center;",
      "  justify-content: space-between;",
      "  gap: 12px;",
      "}"
    ]
  },

  "container_queries": {
    "prefix": ["containerq"],
    "description": "Container query that adapts a card to its own width",
    "body": [
      ".card-host {",
      "  container-type: inline-size;",
