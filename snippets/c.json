  "todo_comment": {
    "prefix": ["todo"],
    "description": "TODO comment with owner and issue reference",
    "body": [
      "// TODO(${1:owner}): describe the change that is still needed.",
      "// Tracked in issue ${2:issue_number}.",
      "// Notes: add a regression test once the fix lands."
    ]
  },

  "struct_with_constructor": {
    "prefix": ["cstruct"],
    "description": "Struct with matching constructor and destructor functions",
    "body": [
      "typedef struct {",
      "  char *data;",
      "  size_t capacity;",
      "  size_t length;",
      "} buffer_t;",
      "",
      "buffer_t buffer_create(size_t capacity) {",
      "  buffer_t buffer = {NULL, 0, 0};",
      "  buffer.data = (char *)malloc(capacity);",
      "  if (buffer.data == NULL) {",
      "    return buffer;",
      "  }",
      "  buffer.capacity = capacity;",
      "  return buffer;",
      "}",
      "",
      "void buffer_destroy(buffer_t *buffer) {",
      "  if (buffer == NULL) {",
      "    return;",
      "  }",
      "  free(buffer->data);",
      "  buffer->data = NULL;",
      "  buffer->capacity = 0;",
      "  buffer->length = 0;",
      "}"
    ]
  },

  "dynamic_array": {
    "prefix": ["dynarray"],
    "description": "Growable array of ints with push and free helpers",
    "body": [
      "typedef struct {",
      "  int *items;",
      "  size_t length;",
      "  size_t capacity;",
      "} int_array_t;",
      "",
      "int int_array_push(int_array_t *array, int value) {",
      "  if (array->length == array->capacity) {",
      "    size_t capacity = array->capacity == 0 ? 8 : array->capacity * 2;",
      "    int *items = (int *)realloc(array->items, capacity * sizeof(int));",
      "    if (items == NULL) {",
      "      return -1;",
      "    }",
      "    array->items = items;",
      "    array->capacity = capacity;",
      "  }",
      "  array->items[array->length++] = value;",
      "  return 0;",
      "}",
      "",
      "void int_array_free(int_array_t *array) {",
      "  free(array->items);",
      "  array->items = NULL;",
      "  array->length = 0;",
      "  array->capacity = 0;",
      "}"
    ]
  },

  "linked_list": {
    "prefix": ["linkedlist"],
    "description": "Singly linked list with push and pop operations",
    "body": [
      "typedef struct list_node {",
      "  int value;",
      "  struct list_node *next;",
      "} list_node_t;",
      "",
      "list_node_t *list_push(list_node_t *head, int value) {",
      "  list_node_t *node = (list_node_t *)malloc(sizeof(*node));",
      "  if (node == NULL) {",
      "    return head;",
      "  }",
      "  node->value = value;",
      "  node->next = head;",
      "  return node;",
      "}",
      "",
      "list_node_t *list_pop(list_node_t *head) {",
      "  if (head == NULL) {",
      "    return NULL;",
      "  }",
      "  list_node_t *next = head->next;",
      "  free(head);",
      "  return next;",
      "}"
    ]
  },

  "hash_map": {
    "prefix": ["hashmap"],
    "description": "String keyed hash map with a simple bucket chain",
    "body": [
      "typedef struct entry {",
      "  char *key;",
      "  void *value;",
      "  struct entry *next;",
      "} entry_t;",
      "",
      "typedef struct {",
      "  entry_t **buckets;",
      "  size_t bucket_count;",
      "  size_t count;",
      "} map_t;",
      "",
      "static size_t hash_key(const char *key, size_t bucket_count) {",
      "  size_t hash = 5381;",
      "  for (const char *cursor = key; *cursor != '\\\\0'; cursor++) {",
      "    hash = hash * 33 + (unsigned char)*cursor;",
      "  }",
      "  return hash % bucket_count;",
      "}",
      "",
      "void *map_get(map_t *map, const char *key) {",
      "  size_t index = hash_key(key, map->bucket_count);",
      "  for (entry_t *entry = map->buckets[index]; entry != NULL; entry = entry->next) {",
      "    if (strcmp(entry->key, key) == 0) {",
      "      return entry->value;",
      "    }",
      "  }",
      "  return NULL;",
      "}"
    ]
  },

  "ring_buffer": {
    "prefix": ["ringbuf"],
    "description": "Fixed size byte ring buffer with push and pop",
    "body": [
      "typedef struct {",
      "  unsigned char *data;",
      "  size_t capacity;",
      "  size_t head;",
      "  size_t tail;",
      "  size_t length;",
      "} ring_buffer_t;",
      "",
      "int ring_buffer_push(ring_buffer_t *buffer, unsigned char byte) {",
      "  if (buffer->length == buffer->capacity) {",
      "    return -1;",
      "  }",
      "  buffer->data[buffer->tail] = byte;",
      "  buffer->tail = (buffer->tail + 1) % buffer->capacity;",
      "  buffer->length++;",
      "  return 0;",
      "}",
      "",
      "int ring_buffer_pop(ring_buffer_t *buffer, unsigned char *out) {",
      "  if (buffer->length == 0) {",
      "    return -1;",
      "  }",
      "  *out = buffer->data[buffer->head];",
      "  buffer->head = (buffer->head + 1) % buffer->capacity;",
      "  buffer->length--;",
      "  return 0;",
      "}"
    ]
  },

  "read_whole_file": {
    "prefix": ["filereader"],
    "description": "Read a whole file into a NUL terminated heap buffer",
    "body": [
      "char *read_entire_file(const char *path, size_t *out_length) {",
      "  FILE *file = fopen(path, \"rb\");",
      "  if (file == NULL) {",
      "    return NULL;",
      "  }",
      "  if (fseek(file, 0, SEEK_END) != 0) {",
      "    fclose(file);",
      "    return NULL;",
      "  }",
      "  long size = ftell(file);",
      "  rewind(file);",
      "  char *buffer = size > 0 ? (char *)malloc((size_t)size + 1) : (char *)calloc(1, 1);",
      "  if (buffer == NULL) {",
      "    fclose(file);",
      "    return NULL;",
      "  }",
      "  size_t read = size > 0 ? fread(buffer, 1, (size_t)size, file) : 0;",
      "  fclose(file);",
      "  buffer[read] = '\\\\0';",
      "  if (out_length != NULL) {",
      "    *out_length = read;",
      "  }",
      "  return buffer;",
      "}"
    ]
  },

  "write_whole_file": {
    "prefix": ["fileio"],
    "description": "Write a buffer to a file with an explicit open mode",
    "body": [
      "int write_entire_file(const char *path, const char *data, size_t length,",
      "                      const char *mode) {",
      "  FILE *file = fopen(path, mode);",
      "  if (file == NULL) {",
      "    return -1;",
      "  }",
      "  size_t written = fwrite(data, 1, length, file);",
      "  int status = written == length ? 0 : -1;",
      "  if (fclose(file) != 0) {",
      "    status = -1;",
      "  }",
      "  return status;",
      "}"
    ]
  },

  "string_helpers": {
    "prefix": ["strutil"],
    "description": "Small string helpers for trimming and prefix checks",
    "body": [
      "int is_space(char c) {",
      "  return c == ' ' || c == '\\\\t' || c == '\\\\n' || c == '\\\\r';",
      "}",
      "",
      "char *trim_whitespace(char *text) {",
      "  while (*text != '\\\\0' && is_space(*text)) {",
      "    text++;",
      "  }",
      "  size_t length = strlen(text);",
      "  while (length > 0 && is_space(text[length - 1])) {",
      "    text[--length] = '\\\\0';",
      "  }",
      "  return text;",
      "}",
      "",
      "int starts_with(const char *text, const char *prefix) {",
      "  return strncmp(text, prefix, strlen(prefix)) == 0;",
      "}"
    ]
  },

  "qsort_comparator": {
    "prefix": ["cmpfunc"],
    "description": "Comparators ready to hand to qsort",
    "body": [
      "int compare_ints(const void *left, const void *right) {",
      "  int a = *(const int *)left;",
      "  int b = *(const int *)right;",
      "  return (a > b) - (a < b);",
      "}",
      "",
      "int compare_strings(const void *left, const void *right) {",
      "  const char *a = *(const char *const *)left;",
      "  const char *b = *(const char *const *)right;",
      "  return strcmp(a, b);",
      "}"
    ]
  },

  "bit_helpers": {
    "prefix": ["bithelpers"],
    "description": "Inline helpers to set, clear and test individual bits",
    "body": [
      "static inline int bit_is_set(unsigned int value, unsigned int bit) {",
      "  return (value & (1u << bit)) != 0;",
      "}",
      "",
      "static inline void bit_set(unsigned int *value, unsigned int bit) {",
      "  *value |= (1u << bit);",
      "}",
      "",
      "static inline void bit_clear(unsigned int *value, unsigned int bit) {",
      "  *value &= ~(1u << bit);",
      "}",
      "",
      "static inline unsigned int bit_range_mask(unsigned int first, unsigned int last) {",
      "  return ((1u << (last - first + 1)) - 1u) << first;",
      "}"
    ]
  },

  "getopt_loop": {
    "prefix": ["getoptloop"],
    "description": "Command line option parsing with getopt in a switch loop",
    "body": [
      "#include <unistd.h>",
      "",
      "int parse_options(int argc, char **argv) {",
      "  int opt;",
      "  while ((opt = getopt(argc, argv, \"hvV\")) != -1) {",
      "    switch (opt) {",
      "      case 'h':",
      "        printf(\"usage: %s [-h] [-v] [-V] <file>\\\\n\", argv[0]);",
      "        return 0;",
      "      case 'v':",
      "        printf(\"verbose logging enabled\\\\n\");",
      "        break;",
      "      case 'V':",
      "        printf(\"version 1.0.0\\\\n\");",
      "        break;",
      "      default:",
      "        fprintf(stderr, \"unknown option: -%c\\\\n\", optopt);",
      "        return 1;",
      "    }",
      "  }",
      "  return 2;",
      "}"
    ]
  },

  "argument_parsing": {
    "prefix": ["argparse"],
    "description": "Look up named flags and values inside argv",
    "body": [
      "const char *option_value(int argc, char **argv, const char *name) {",
      "  for (int i = 1; i < argc - 1; i++) {",
      "    if (strcmp(argv[i], name) == 0) {",
      "      return argv[i + 1];",
      "    }",
      "  }",
      "  return NULL;",
      "}",
      "",
      "int has_flag(int argc, char **argv, const char *name) {",
      "  for (int i = 1; i < argc; i++) {",
      "    if (strcmp(argv[i], name) == 0) {",
      "      return 1;",
      "    }",
      "  }",
      "  return 0;",
      "}"
    ]
  },

  "error_goto_cleanup": {
    "prefix": ["errgoto"],
    "description": "Error handling that funnels every exit through cleanup",
    "body": [
      "int read_config(const char *path) {",
      "  int status = -1;",
      "  FILE *file = fopen(path, \"rb\");",
      "  if (file == NULL) {",
      "    fprintf(stderr, \"cannot open %s\\\\n\", path);",
      "    return -1;",
      "  }",
      "  char line[256];",
      "  while (fgets(line, sizeof(line), file) != NULL) {",
      "    if (line[0] == '#') {",
      "      continue;",
      "    }",
      "    printf(\"%s\", line);",
      "  }",
      "  if (ferror(file)) {",
      "    goto cleanup;",
      "  }",
      "  status = 0;",
      "cleanup:",
      "  fclose(file);",
      "  return status;",
      "}"
    ]
  },

  "checked_alloc": {
    "prefix": ["xmalloc"],
    "description": "Allocation wrappers that abort instead of returning NULL",
    "body": [
      "void *xmalloc(size_t size) {",
      "  void *memory = malloc(size);",
      "  if (memory == NULL) {",
      "    fprintf(stderr, \"out of memory: %zu bytes\\\\n\", size);",
      "    exit(EXIT_FAILURE);",
      "  }",
      "  return memory;",
      "}",
      "",
      "void *xrealloc(void *memory, size_t size) {",
      "  void *grown = realloc(memory, size);",
      "  if (grown == NULL) {",
      "    fprintf(stderr, \"out of memory: %zu bytes\\\\n\", size);",
      "    exit(EXIT_FAILURE);",
      "  }",
      "  return grown;",
      "}",
      "",
      "char *xstrdup(const char *text) {",
      "  size_t size = strlen(text) + 1;",
      "  char *copy = (char *)xmalloc(size);",
      "  memcpy(copy, text, size);",
      "  return copy;",
      "}"
    ]
  },

  "log_macros": {
    "prefix": ["logmacro"],
    "description": "Level filtered logging macros writing to stderr",
    "body": [
      "#define LOG_LEVEL_DEBUG 0",
      "#define LOG_LEVEL_INFO 1",
      "#define LOG_LEVEL_WARN 2",
      "#define LOG_LEVEL_ERROR 3",
      "",
      "#ifndef LOG_LEVEL",
      "#define LOG_LEVEL LOG_LEVEL_INFO",
      "#endif",
      "",
      "#define LOG_PRINTF(level, ...)               \\\\",
      "  do {                                       \\\\",
      "    if ((level) >= LOG_LEVEL) {             \\\\",
      "      fprintf(stderr, \"[%d] \", (level));     \\\\",
      "      fprintf(stderr, __VA_ARGS__);         \\\\",
      "      fputc('\\\\n', stderr);                   \\\\",
      "    }                                        \\\\",
      "  } while (0)",
      "",
      "#define LOG_DEBUG(...) LOG_PRINTF(LOG_LEVEL_DEBUG, __VA_ARGS__)",
      "#define LOG_INFO(...) LOG_PRINTF(LOG_LEVEL_INFO, __VA_ARGS__)",
      "#define LOG_WARN(...) LOG_PRINTF(LOG_LEVEL_WARN, __VA_ARGS__)",
      "#define LOG_ERROR(...) LOG_PRINTF(LOG_LEVEL_ERROR, __VA_ARGS__)"
    ]
  },

