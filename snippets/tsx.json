  "tsx_modal_dialog": {
    "prefix": ["modal"],
    "description": "Modal dialog that closes on escape and on backdrop click",
    "body": [
      "import { createElement, useEffect, type MouseEvent, type ReactNode } from 'react';",
      "",
      "interface ModalProps {",
      "  open: boolean;",
      "  title: string;",
      "  onClose: () => void;",
      "  children: ReactNode;",
      "}",
      "",
      "export function Modal({ open, title, onClose, children }: ModalProps) {",
      "  useEffect(() => {",
      "    if (!open) {",
      "      return;",
      "    }",
      "",
      "    const onKeyDown = (event: KeyboardEvent) => {",
      "      if (event.key === 'Escape') {",
      "        onClose();",
      "      }",
      "    };",
      "",
      "    window.addEventListener('keydown', onKeyDown);",
      "    return () => window.removeEventListener('keydown', onKeyDown);",
      "  }, [open, onClose]);",
      "",
      "  if (!open) {",
      "    return null;",
      "  }",
      "",
      "  return createElement(",
      "    'div',",
      "    { className: 'modal__backdrop', onClick: onClose },",
      "    createElement(",
      "      'div',",
      "      {",
      "        className: 'modal',",
      "        role: 'dialog',",
      "        'aria-modal': true,",
      "        'aria-label': title,",
      "        onClick: (event: MouseEvent<HTMLDivElement>) => event.stopPropagation(),",
      "      },",
      "      createElement('h2', { className: 'modal__title' }, title),",
      "      createElement('div', { className: 'modal__body' }, children),",
      "    ),",
      "  );",
      "}"
    ]
  },

  "tsx_table_component": {
    "prefix": ["tablecomp"],
    "description": "Generic table that renders columns and rows from data",
    "body": [
      "import { createElement } from 'react';",
      "",
      "interface Column<T> {",
      "  key: keyof T;",
      "  header: string;",
      "  render?: (row: T) => string;",
      "}",
      "",
      "interface TableProps<T> {",
      "  columns: Array<Column<T>>;",
      "  rows: T[];",
      "  caption?: string;",
      "}",
      "",
      "export function Table<T extends { id: string }>({ columns, rows, caption }: TableProps<T>) {",
      "  return createElement(",
      "    'table',",
      "    { className: 'table' },",
      "    caption ? createElement('caption', null, caption) : null,",
      "    createElement(",
      "      'thead',",
      "      null,",
      "      createElement(",
      "        'tr',",
      "        null,",
      "        columns.map((column) =>",
      "          createElement('th', { key: String(column.key), scope: 'col' }, column.header),",
      "        ),",
      "      ),",
      "    ),",
      "    createElement(",
      "      'tbody',",
      "      null,",
      "      rows.map((row) =>",
      "        createElement(",
      "          'tr',",
      "          { key: row.id },",
      "          columns.map((column) =>",
      "            createElement(",
      "              'td',",
      "              { key: String(column.key) },",
      "              column.render ? column.render(row) : String(row[column.key]),",
      "            ),",
      "          ),",
      "        ),",
      "      ),",
      "    ),",
      "  );",
      "}"
    ]
  },

  "tsx_forward_ref": {
    "prefix": ["forwardref"],
    "description": "Component that forwards its ref to the inner input element",
    "body": [
      "import { createElement, forwardRef } from 'react';",
