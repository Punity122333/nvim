      "      error ? createElement('small', { className: 'field__error' }, error) : null,",
      "    );",
      "  },",
      ");"
    ]
  },

  "tsx_use_reducer": {
    "prefix": ["reducer"],
    "description": "Reducer with typed actions and a component that dispatches them",
    "body": [
      "import { createElement, useReducer } from 'react';",
      "",
      "interface State {",
      "  count: number;",
      "  status: 'idle' | 'saving' | 'saved';",
      "}",
      "",
      "type Action =",
      "  | { type: 'increment'; by: number }",
      "  | { type: 'reset' }",
      "  | { type: 'saving' }",
      "  | { type: 'saved' };",
      "",
      "function reducer(state: State, action: Action): State {",
      "  switch (action.type) {",
      "    case 'increment':",
      "      return { ...state, count: state.count + action.by };",
      "    case 'reset':",
      "      return { count: 0, status: 'idle' };",
      "    case 'saving':",
      "      return { ...state, status: 'saving' };",
      "    case 'saved':",
      "      return { ...state, status: 'saved' };",
      "    default:",
      "      return state;",
      "  }",
      "}",
      "",
      "export function Counter() {",
      "  const [state, dispatch] = useReducer(reducer, { count: 0, status: 'idle' });",
      "",
      "  return createElement(",
      "    'button',",
      "    { type: 'button', onClick: () => dispatch({ type: 'increment', by: 1 }) },",
      "    `\\${state.count} (\\${state.status})`,",
      "  );",
      "}"
    ]
  },

  "tsx_component_test": {
    "prefix": ["comptest"],
    "description": "Smoke test that renders a component to static markup",
    "body": [
      "import { createElement } from 'react';",
      "import { renderToStaticMarkup } from 'react-dom/server';",
      "",
      "function Greeting({ name }: { name: string }) {",
      "  return createElement('p', { className: 'greeting' }, `Hello, \\${name}!`);",
      "}",
      "",
      "const html = renderToStaticMarkup(createElement(Greeting, { name: 'Ada' }));",
      "",
      "if (!html.includes('Hello, Ada!')) {",
      "  throw new Error(`unexpected markup: \\${html}`);",
      "}"
    ]
  },

