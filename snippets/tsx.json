  "tsx_error_boundary": {
    "prefix": ["errboundary"],
    "description": "Error boundary that catches render errors of its children",
    "body": [
      "import { Component, createElement, type ErrorInfo, type ReactNode } from 'react';",
      "",
      "interface ErrorBoundaryProps {",
      "  children: ReactNode;",
      "  fallback?: ReactNode;",
      "}",
      "",
      "interface ErrorBoundaryState {",
      "  error: Error | null;",
      "}",
      "",
      "export class ErrorBoundary extends Component<ErrorBoundaryProps, ErrorBoundaryState> {",
      "  state: ErrorBoundaryState = { error: null };",
      "",
      "  static getDerivedStateFromError(error: Error): ErrorBoundaryState {",
      "    return { error };",
      "  }",
      "",
      "  componentDidCatch(error: Error, info: ErrorInfo): void {",
      "    console.error('render failed', error, info);",
      "  }",
      "",
      "  render() {",
      "    if (this.state.error) {",
      "      return this.props.fallback ?? createElement('p', { role: 'alert' }, 'Something went wrong.');",
      "    }",
      "    return this.props.children;",
      "  }",
      "}"
    ]
  },

  "tsx_portal": {
    "prefix": ["portal"],
    "description": "Render children into another part of the DOM with a portal",
    "body": [
      "import { createElement, type ReactNode } from 'react';",
      "import { createPortal } from 'react-dom';",
      "",
      "interface PortalProps {",
      "  children: ReactNode;",
      "  target?: string;",
      "}",
      "",
      "export function Portal({ children, target = 'modal-root' }: PortalProps) {",
      "  const host = document.getElementById(target);",
      "  if (!host) {",
      "    return null;",
      "  }",
      "",
      "  return createPortal(createElement('div', { className: 'portal' }, children), host);",
      "}"
    ]
  },

  "tsx_lazy_component": {
    "prefix": ["lazycomp"],
    "description": "Lazy loaded component wrapped in a suspense boundary",
    "body": [
      "import { createElement, lazy, Suspense } from 'react';",
      "",
      "// The bundler resolves the module path when the chunk is requested.",
      "const reportsModule = './Reports';",
      "",
      "const Reports = lazy(() => import(reportsModule));",
      "",
      "export function ReportsPage() {",
      "  return createElement(",
      "    Suspense,",
      "    { fallback: createElement('p', null, 'Loading reports...') },",
      "    createElement(Reports),",
      "  );",
      "}"
    ]
  },

  "tsx_loading_spinner": {
    "prefix": ["spinner"],
