{
  "tsx_function_component": {
    "prefix": ["fncomp"],
    "description": "Functional component with typed props and a variant",
    "body": [
      "import { createElement } from 'react';",
      "",
      "interface GreetingProps {",
      "  name: string;",
      "  variant?: 'primary' | 'secondary';",
      "  onSelect?: () => void;",
      "}",
      "",
      "export function Greeting({ name, variant = 'primary', onSelect }: GreetingProps) {",
      "  return createElement(",
      "    'button',",
      "    { type: 'button', className: `greeting greeting--\\${variant}`, onClick: onSelect },",
      "    `Hello, \\${name}`,",
      "  );",
      "}"
    ]
  },

  "tsx_component_with_hooks": {
    "prefix": ["hookcomp"],
    "description": "Component that keeps the clock state and cleans up the timer",
    "body": [
      "import { createElement, useEffect, useState } from 'react';",
      "",
      "interface ClockProps {",
      "  intervalMs?: number;",
      "}",
      "",
      "export function Clock({ intervalMs = 1000 }: ClockProps) {",
      "  const [now, setNow] = useState(() => new Date());",
      "",
      "  useEffect(() => {",
      "    const timer = setInterval(() => setNow(new Date()), intervalMs);",
      "    return () => clearInterval(timer);",
      "  }, [intervalMs]);",
      "",
      "  return createElement('time', { dateTime: now.toISOString() }, now.toLocaleTimeString());",
      "}"
    ]
  },

  "tsx_custom_hook": {
    "prefix": ["hook"],
    "description": "Custom hook that tracks the online status of the browser",
    "body": [
      "import { useEffect, useState } from 'react';",
      "",
      "export function useOnlineStatus(): boolean {",
      "  const [online, setOnline] = useState(true);",
      "",
      "  useEffect(() => {",
      "    const update = () => setOnline(navigator.onLine);",
      "",
      "    window.addEventListener('online', update);",
      "    window.addEventListener('offline', update);",
      "    update();",
      "",
      "    return () => {",
      "      window.removeEventListener('online', update);",
      "      window.removeEventListener('offline', update);",
      "    };",
      "  }, []);",
      "",
      "  return online;",
      "}"
    ]
  },

  "tsx_context_provider": {
    "prefix": ["ctxprovider"],
    "description": "Context provider with a typed value and a consumer hook",
    "body": [
      "import { createContext, createElement, useContext, useMemo, useState, type ReactNode } from 'react';",
      "",
      "interface ThemeValue {",
      "  theme: 'light' | 'dark';",
      "  toggleTheme: () => void;",
      "}",
      "",
      "const ThemeContext = createContext<ThemeValue | null>(null);",
      "",
      "export function ThemeProvider({ children }: { children: ReactNode }) {",
      "  const [theme, setTheme] = useState<'light' | 'dark'>('light');",
      "",
      "  const value = useMemo(",
      "    () => ({",
      "      theme,",
      "      toggleTheme: () => setTheme((current) => (current === 'light' ? 'dark' : 'light')),",
      "    }),",
      "    [theme],",
      "  );",
      "",
      "  return createElement(ThemeContext.Provider, { value }, children);",
      "}",
      "",
      "export function useTheme(): ThemeValue {",
      "  const context = useContext(ThemeContext);",
      "  if (!context) {",
      "    throw new Error('useTheme must be used inside a ThemeProvider');",
      "  }",
      "  return context;",
      "}"
    ]
  },

  "tsx_list_with_keys": {
    "prefix": ["listmap"],
    "description": "Render a list of users with stable keys and an empty state",
    "body": [
      "import { createElement } from 'react';",
      "",
      "interface User {",
      "  id: string;",
      "  name: string;",
      "  email: string;",
      "}",
      "",
      "interface UserListProps {",
      "  users: User[];",
      "  onSelect?: (id: string) => void;",
      "}",
      "",
      "export function UserList({ users, onSelect }: UserListProps) {",
      "  if (users.length === 0) {",
      "    return createElement('p', { className: 'user-list__empty' }, 'No users found');",
      "  }",
      "",
      "  return createElement(",
      "    'ul',",
      "    { className: 'user-list' },",
      "    users.map((user) =>",
      "      createElement(",
      "        'li',",
      "        { key: user.id, onClick: () => onSelect?.(user.id) },",
      "        createElement('span', { className: 'user-list__name' }, user.name),",
      "        createElement('span', { className: 'user-list__email' }, user.email),",
      "      ),",
      "    ),",
      "  );",
      "}"
    ]
  },

  "tsx_conditional_render": {
    "prefix": ["condrender"],
    "description": "Component that renders a different branch per status",
    "body": [
      "import { createElement, type ReactNode } from 'react';",
      "",
      "interface StatusViewProps {",
      "  status: 'idle' | 'loading' | 'error' | 'ready';",
      "  error?: string;",
      "  children?: ReactNode;",
      "}",
      "",
      "export function StatusView({ status, error, children }: StatusViewProps) {",
      "  if (status === 'loading') {",
      "    return createElement('div', { className: 'spinner', role: 'status', 'aria-label': 'Loading' });",
      "  }",
      "",
      "  if (status === 'error') {",
      "    return createElement(",
      "      'p',",
      "      { className: 'error', role: 'alert' },",
      "      error ?? 'Something went wrong',",
      "    );",
      "  }",
      "",
      "  if (status === 'idle') {",
      "    return null;",
      "  }",
      "",
      "  return createElement('section', { className: 'content' }, children);",
      "}"
    ]
  },

  "tsx_form_component": {
    "prefix": ["formcomp"],
    "description": "Controlled form component that submits email and password",
    "body": [
      "import { createElement, useState, type FormEvent } from 'react';",
      "",
      "interface LoginFormProps {",
      "  onSubmit: (email: string, password: string) => void;",
      "}",
      "",
      "export function LoginForm({ onSubmit }: LoginFormProps) {",
      "  const [email, setEmail] = useState('');",
      "  const [password, setPassword] = useState('');",
      "",
      "  function handleSubmit(event: FormEvent<HTMLFormElement>) {",
      "    event.preventDefault();",
      "    onSubmit(email, password);",
      "  }",
      "",
      "  return createElement(",
      "    'form',",
      "    { className: 'login', onSubmit: handleSubmit },",
      "    createElement('label', { htmlFor: 'email' }, 'Email'),",
      "    createElement('input', {",
      "      id: 'email',",
      "      type: 'email',",
      "      value: email,",
      "      onChange: (event) => setEmail(event.target.value),",
      "      required: true,",
      "    }),",
      "    createElement('label', { htmlFor: 'password' }, 'Password'),",
      "    createElement('input', {",
      "      id: 'password',",
      "      type: 'password',",
      "      value: password,",
      "      onChange: (event) => setPassword(event.target.value),",
      "      required: true,",
      "    }),",
      "    createElement('button', { type: 'submit' }, 'Sign in'),",
      "  );",
      "}"
    ]
  },

