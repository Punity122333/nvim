  "jsx_tsx_context_provider": {
    "prefix": ["jsxctxprovider"],
    "description": "Context provider with a typed value and a consumer hook (JSX)",
    "body": [
      "import { createContext, useContext, useMemo, useState, type ReactNode } from 'react';",
      "",
      "type ThemeValue = {",
      "  theme: 'light' | 'dark';",
      "  toggleTheme: () => void;",
      "};",
      "",
      "const ThemeContext = createContext<ThemeValue | null>(null);",
      "",
      "export function ThemeProvider({ children }: { children: ReactNode }) {",
      "  const [theme, setTheme] = useState<'light' | 'dark'>('light');",
      "  const value = useMemo<ThemeValue>(",
      "    () => ({ theme, toggleTheme: () => setTheme((current) => (current === 'light' ? 'dark' : 'light')) }),",
      "    [theme],",
      "  );",
      "",
      "  return <ThemeContext.Provider value={value}>{children}</ThemeContext.Provider>;",
      "}",
      "",
      "export function useTheme(): ThemeValue {",
      "  const context = useContext(ThemeContext);",
      "  if (!context) throw new Error('useTheme must be used inside a ThemeProvider');",
      "  return context;",
      "}"
    ]
  },

  "jsx_tsx_list_with_keys": {
    "prefix": ["jsxlistmap"],
    "description": "Render a list of users with stable keys and an empty state (JSX)",
    "body": [
      "type User = {",
      "  id: string;",
      "  name: string;",
      "  email: string;",
      "};",
      "",
      "type UserListProps = {",
      "  users: User[];",
      "  onSelect?: (id: string) => void;",
      "};",
      "",
      "export function UserList({ users, onSelect }: UserListProps) {",
      "  if (users.length === 0) {",
      "    return <p className=\"user-list__empty\">No users found</p>;",
      "  }",
      "",
      "  return (",
      "    <ul className=\"user-list\">",
      "      {users.map((user) => (",
      "        <li key={user.id} onClick={() => onSelect?.(user.id)}>",
      "          <span className=\"user-list__name\">{user.name}</span>",
      "          <span className=\"user-list__email\">{user.email}</span>",
      "        </li>",
      "      ))}",
      "    </ul>",
      "  );",
      "}"
    ]
  },

  "jsx_tsx_conditional_render": {
    "prefix": ["jsxcondrender"],
    "description": "Component that renders a different branch per status (JSX)",
    "body": [
      "import type { ReactNode } from 'react';",
      "",
      "type StatusViewProps = {",
      "  status: 'idle' | 'loading' | 'error' | 'ready';",
      "  error?: string;",
      "  children?: ReactNode;",
      "};",
      "",
      "export function StatusView({ status, error, children }: StatusViewProps) {",
      "  if (status === 'loading') {",
      "    return <div className=\"spinner\" role=\"status\" aria-label=\"${1:Loading}\" />;",
      "  }",
      "",
      "  if (status === 'error') {",
      "    return <p className=\"error\" role=\"alert\">{error ?? 'Something went wrong'}</p>;",
      "  }",
      "",
      "  if (status === 'idle') {",
      "    return null;",
      "  }",
      "",
      "  return <section className=\"content\">{children}</section>;",
      "}"
    ]
  },

  "jsx_tsx_form_component": {
    "prefix": ["jsxformcomp"],
    "description": "Controlled form component that submits email and password (JSX)",
    "body": [
      "import { useState, type FormEvent } from 'react';",
      "",
      "type LoginFormProps = {",
      "  onSubmit: (email: string, password: string) => void;",
      "};",
      "",
      "export function LoginForm({ onSubmit }: LoginFormProps) {",
      "  const [email, setEmail] = useState('');",
      "  const [password, setPassword] = useState('');",
      "",
      "  function handleSubmit(event: FormEvent<HTMLFormElement>) {",
      "    event.preventDefault();",
      "    onSubmit(email, password);",
      "  }",
      "",
      "  return (",
      "    <form className=\"login\" onSubmit={handleSubmit}>",
      "      <label htmlFor=\"email\">Email</label>",
      "      <input id=\"email\" type=\"email\" required placeholder=\"${1:you@example.com}\"",
      "        value={email} onChange={(event) => setEmail(event.target.value)} />",
      "      <label htmlFor=\"password\">Password</label>",
      "      <input id=\"password\" type=\"password\" required",
      "        value={password} onChange={(event) => setPassword(event.target.value)} />",
      "      <button type=\"submit\">Sign in</button>",
      "    </form>",
      "  );",
      "}"
    ]
  },

  "jsx_tsx_use_ref": {
    "prefix": ["jsxuseref"],
    "description": "Ref that is attached to an input and focused on demand (JSX)",
    "body": [
      "import { useRef } from 'react';",
      "",
      "export function SearchInput() {",
      "  const inputRef = useRef<HTMLInputElement>(null);",
      "",
      "  function focusInput() {",
      "    inputRef.current?.focus();",
      "  }",
      "",
      "  return (",
      "    <div className=\"search\">",
      "      <input ref={inputRef} type=\"search\" placeholder=\"${1:Search}\" />",
      "      <button type=\"button\" onClick={focusInput}>Focus</button>",
      "    </div>",
      "  );",
      "}"
    ]
  },

  "jsx_tsx_memo_component": {
    "prefix": ["jsxmemocomp"],
    "description": "Memoized row component that only rerenders on prop changes (JSX)",
    "body": [
      "import { memo, useCallback } from 'react';",
      "",
      "type RowProps = {",
      "  id: string;",
      "  label: string;",
      "  onSelect: (id: string) => void;",
      "};",
      "",
      "export const Row = memo(function Row({ id, label, onSelect }: RowProps) {",
      "  return (",
      "    <button type=\"button\" className=\"row\" onClick={() => onSelect(id)}>",
      "      {label}",
      "    </button>",
      "  );",
      "});",
      "",
      "export function RowList({ rows, onSelect }: { rows: RowProps[]; onSelect: (id: string) => void }) {",
      "  const handleSelect = useCallback((id: string) => onSelect(id), [onSelect]);",
      "",
      "  return (",
      "    <ul className=\"rows\">",
      "      {rows.map((row) => (",
      "        <Row key={row.id} id={row.id} label={row.label} onSelect={handleSelect} />",
      "      ))}",
      "    </ul>",
      "  );",
      "}"
    ]
  },

  "jsx_tsx_class_component": {
    "prefix": ["jsxclasscomp"],
    "description": "Class component with typed state and an updater callback (JSX)",
    "body": [
      "import { Component } from 'react';",
      "",
      "type CounterProps = {",
      "  start?: number;",
      "  onChange?: (value: number) => void;",
      "};",
      "",
      "type CounterState = {",
      "  count: number;",
      "};",
      "",
      "export class Counter extends Component<CounterProps, CounterState> {",
      "  state: CounterState = { count: this.props.start ?? 0 };",
      "",
      "  private increment = () => {",
      "    this.setState(",
      "      (previous) => ({ count: previous.count + 1 }),",
      "      () => this.props.onChange?.(this.state.count),",
      "    );",
      "  };",
      "",
      "  render() {",
      "    return (",
      "      <button type=\"button\" onClick={this.increment}>",
      "        Count: {this.state.count}",
      "      </button>",
      "    );",
      "  }",
      "}"
    ]
  },

  "jsx_tsx_fragment": {
    "prefix": ["jsxfragment"],
    "description": "Shorthand fragment that groups two elements without a wrapper (JSX)",
    "body": [
      "type DefinitionProps = {",
      "  term: string;",
      "  description: string;",
      "};",
      "",
      "export function Definition({ term, description }: DefinitionProps) {",
      "  return (",
      "    <>",
      "      <dt className=\"definition__term\">{term}</dt>",
      "      <dd className=\"definition__description\">{description}</dd>",
      "    </>",
      "  );",
      "}"
    ]
  },

  "jsx_tsx_error_boundary": {
    "prefix": ["jsxerrboundary"],
    "description": "Error boundary that catches render errors of its children (JSX)",
    "body": [
      "import { Component, type ErrorInfo, type ReactNode } from 'react';",
      "",
      "type ErrorBoundaryProps = {",
      "  children: ReactNode;",
      "  fallback?: ReactNode;",
      "};",
      "",
      "type ErrorBoundaryState = {",
      "  error: Error | null;",
      "};",
      "",
      "export class ErrorBoundary extends Component<ErrorBoundaryProps, ErrorBoundaryState> {",
      "  state: ErrorBoundaryState = { error: null };",
      "",
      "  static getDerivedStateFromError(error: Error): ErrorBoundaryState {",
      "    return { error };",
      "  }",
      "",
      "  componentDidCatch(error: Error, info: ErrorInfo): void {",
      "    console.error('render failed', error, info);",
      "  }",
      "",
      "  render() {",
      "    if (this.state.error) {",
      "      return this.props.fallback ?? <p role=\"alert\">Something went wrong.</p>;",
      "    }",
      "    return this.props.children;",
      "  }",
      "}"
    ]
  },

  "jsx_tsx_portal": {
    "prefix": ["jsxportal"],
    "description": "Render children into another part of the DOM with a portal (JSX)",
    "body": [
      "import { type ReactNode } from 'react';",
      "import { createPortal } from 'react-dom';",
      "",
      "type PortalProps = {",
      "  children: ReactNode;",
      "  target?: string;",
      "};",
      "",
      "export function Portal({ children, target = '${1:modal-root}' }: PortalProps) {",
      "  const host = document.getElementById(target);",
      "  if (!host) {",
      "    return null;",
      "  }",
      "",
      "  return createPortal(<div className=\"portal\">{children}</div>, host);",
      "}"
    ]
  },

  "jsx_tsx_lazy_component": {
    "prefix": ["jsxlazycomp"],
    "description": "Lazy loaded component wrapped in a suspense boundary (JSX)",
    "body": [
      "import { lazy, Suspense } from 'react';",
      "",
      "// The bundler resolves the module path when the chunk is requested.",
      "const reportsModule = './Reports';",
      "",
      "const Reports = lazy(() => import(reportsModule));",
      "",
      "export function ReportsPage() {",
      "  return (",
      "    <Suspense fallback={<p role=\"status\">Loading reports...</p>}>",
      "      <Reports />",
      "    </Suspense>",
      "  );",
      "}"
    ]
  },

  "jsx_tsx_loading_spinner": {
    "prefix": ["jsxspinner"],
    "description": "Accessible loading spinner with a configurable size (JSX)",
    "body": [
      "type SpinnerProps = {",
      "  size?: number;",
      "  label?: string;",
      "};",
      "",
      "export function Spinner({ size = 24, label = '${1:Loading}' }: SpinnerProps) {",
      "  return (",
      "    <span className=\"spinner\" role=\"status\" aria-live=\"polite\" aria-label={label}>",
      "      <span className=\"spinner__dot\" style={{ width: size, height: size }} />",
      "    </span>",
      "  );",
      "}"
    ]
  },

  "jsx_tsx_modal_dialog": {
    "prefix": ["jsxmodal"],
    "description": "Modal dialog that closes on escape and on backdrop click (JSX)",
    "body": [
      "import { useEffect, type MouseEvent, type ReactNode } from 'react';",
      "",
      "type ModalProps = {",
      "  open: boolean;",
      "  title: string;",
      "  onClose: () => void;",
      "  children: ReactNode;",
      "};",
      "",
      "export function Modal({ open, title, onClose, children }: ModalProps) {",
      "  useEffect(() => {",
      "    if (!open) {",
      "      return;",
      "    }",
      "    const onKeyDown = (event: KeyboardEvent) => {",
      "      if (event.key === 'Escape') onClose();",
      "    };",
      "    window.addEventListener('keydown', onKeyDown);",
      "    return () => window.removeEventListener('keydown', onKeyDown);",
      "  }, [open, onClose]);",
      "",
      "  if (!open) {",
      "    return null;",
      "  }",
      "",
      "  return (",
      "    <div className=\"modal__backdrop\" onClick={onClose}>",
      "      <div",
      "        className=\"modal\"",
      "        role=\"dialog\"",
      "        aria-modal=\"true\"",
      "        aria-label={title}",
      "        onClick={(event: MouseEvent<HTMLDivElement>) => event.stopPropagation()}",
      "      >",
      "        <h2 className=\"modal__title\">{title}</h2>",
      "        <div className=\"modal__body\">{children}</div>",
      "      </div>",
      "    </div>",
      "  );",
      "}"
    ]
  },

  "jsx_tsx_table_component": {
    "prefix": ["jsxtablecomp"],
    "description": "Generic table that renders columns and rows from data (JSX)",
    "body": [
      "type Column<T> = {",
      "  key: keyof T;",
      "  header: string;",
      "  render?: (row: T) => string;",
      "};",
      "",
      "type TableProps<T> = {",
      "  columns: Array<Column<T>>;",
      "  rows: T[];",
      "  caption?: string;",
      "};",
      "",
      "export function Table<T extends { id: string }>({ columns, rows, caption }: TableProps<T>) {",
      "  return (",
      "    <table className=\"table\">",
      "      {caption && <caption>{caption}</caption>}",
      "      <thead>",
      "        <tr>",
      "          {columns.map((column) => (",
      "            <th key={String(column.key)} scope=\"col\">",
      "              {column.header}",
      "            </th>",
      "          ))}",
      "        </tr>",
      "      </thead>",
      "      <tbody>",
      "        {rows.map((row) => (",
      "          <tr key={row.id}>",
      "            {columns.map((column) => (",
      "              <td key={String(column.key)}>",
      "                {column.render ? column.render(row) : String(row[column.key])}",
      "              </td>",
      "            ))}",
      "          </tr>",
      "        ))}",
      "      </tbody>",
      "    </table>",
      "  );",
      "}"
    ]
  },

  "jsx_tsx_forward_ref": {
    "prefix": ["jsxforwardref"],
    "description": "Component that forwards its ref to the inner input element (JSX)",
    "body": [
      "import { forwardRef } from 'react';",
      "",
      "type TextInputProps = {",
      "  label: string;",
      "  error?: string;",
      "};",
      "",
      "export const TextInput = forwardRef<HTMLInputElement, TextInputProps>(",
      "  function TextInput({ label, error }, ref) {",
      "    return (",
      "      <label className=\"field\">",
      "        <span className=\"field__label\">{label}</span>",
      "        <input ref={ref} type=\"text\" placeholder=\"${1:Value}\" aria-invalid={Boolean(error)} />",
      "        {error && <small className=\"field__error\">{error}</small>}",
      "      </label>",
      "    );",
      "  },",
      ");"
    ]
  },

  "jsx_tsx_use_reducer": {
    "prefix": ["jsxreducer"],
    "description": "Reducer with typed actions and a component that dispatches them (JSX)",
    "body": [
      "import { useReducer } from 'react';",
      "",
      "type State = {",
      "  count: number;",
      "  status: 'idle' | 'saving' | 'saved';",
      "};",
      "",
      "type Action =",
      "  | { type: 'increment'; by: number }",
      "  | { type: 'reset' }",
      "  | { type: 'saving' }",
      "  | { type: 'saved' };",
      "",
      "function reducer(state: State, action: Action): State {",
      "  switch (action.type) {",
      "    case 'increment':",
      "      return { ...state, count: state.count + action.by };",
      "    case 'reset':",
      "      return { count: 0, status: 'idle' };",
      "    case 'saving':",
      "    case 'saved':",
      "      return { ...state, status: action.type };",
      "    default:",
      "      return state;",
      "  }",
      "}",
      "",
      "export function Counter() {",
      "  const [state, dispatch] = useReducer(reducer, { count: 0, status: 'idle' });",
      "",
      "  return (",
      "    <button type=\"button\" onClick={() => dispatch({ type: 'increment', by: 1 })}>",
      "      {state.count} ({state.status})",
      "    </button>",
      "  );",
      "}"
    ]
  },

  "jsx_tsx_component_test": {
    "prefix": ["jsxcomptest"],
    "description": "Smoke test that renders a component to static markup (JSX)",
    "body": [
      "import { renderToStaticMarkup } from 'react-dom/server';",
      "",
      "const name = '${1:Ada}';",
      "",
      "function Greeting({ name }: { name: string }) {",
      "  return <p className=\"greeting\">Hello, {name}!</p>;",
      "}",
      "",
      "const html = renderToStaticMarkup(<Greeting name={name} />);",
      "",
      "if (!html.includes(`Hello, \\${name}!`)) {",
      "  throw new Error(`unexpected markup: \\${html}`);",
      "}"
    ]
  }
}
