{
  "section": {
    "prefix": ["section", "sect"],
    "description": "INI section header with the keys it holds",
    "body": [
      "[server]",
      "host = localhost",
      "port = 8080",
      "timeout = 30",
      "retry_limit = 5"
    ]
  },

  "key_value": {
    "prefix": ["keyval", "kv"],
    "description": "INI key and value pair inside a section",
    "body": [
      "[general]",
      "name = acme-service",
      "owner = platform-team"
    ]
  },

  "comments": {
    "prefix": ["comments", "comment"],
    "description": "INI comment block using ; and # markers",
    "body": [
      "; Application configuration",
      "; Edit carefully, changes need a restart to take effect.",
      "",
      "# The section below holds the defaults for every environment.",
      "[defaults]"
    ]
  },

  "global_section": {
    "prefix": ["globalsection", "global"],
    "description": "INI global section placed before any other section",
    "body": [
      "[global]",
      "user = root",
      "umask = 022"
    ]
  },

  "repeated_keys": {
    "prefix": ["repeatkeys", "repeated"],
    "description": "INI section that repeats the same key several times",
    "body": [
      "[paths]",
      "include = src",
      "include = test",
      "include = docs"
    ]
  },

  "key_with_path": {
    "prefix": ["keypath", "paths"],
    "description": "INI keys holding file system paths",
    "body": [
      "[build]",
      "source_dir = /srv/app/src",
      "build_dir = /var/lib/app/build",
      "config_file = ./config/settings.ini"
    ]
  },

  "quoted_value": {
    "prefix": ["quotedval", "quoted"],
    "description": "INI values wrapped in single or double quotes",
    "body": [
      "[server]",
      "motd = \"Welcome to the acme service\"",
      "banner = 'Service starting up'"
    ]
  },

  "list_of_values": {
    "prefix": ["listvalues", "listval"],
    "description": "INI key holding a comma separated list of values",
    "body": [
      "[features]",
      "flags = metrics, tracing, rate-limiting",
      "hosts = alpha.internal, beta.internal"
    ]
  },

  "config_header": {
    "prefix": ["confheader", "header"],
    "description": "INI file header comment describing the file",
    "body": [
      "; ---------------------------------------------------------------------------",
      "; acme-service configuration",
      "; Generated by the deployment tooling - do not edit by hand.",
      "; ---------------------------------------------------------------------------",
      "",
      "[app]",
      "name = acme-service"
    ]
  },

  "nested_section": {
    "prefix": ["nestsection", "subsec"],
    "description": "INI section whose name is dotted",
    "body": [
      "[database.pool]",
      "min_size = 2",
      "max_size = 10",
      "timeout = 30"
    ]
  },

  "key_with_default": {
    "prefix": ["keydefault", "default"],
    "description": "INI key documented with the default value it uses",
    "body": [
      "[server]",
      "; Default port used when the service listens on every interface",
      "port = 8080",
      "; Seconds to wait for in flight requests before shutting down",
      "graceful_shutdown = 15"
    ]
  },

  "application_config": {
    "prefix": ["appconfig", "app"],
    "description": "INI section holding the application settings",
    "body": [
      "[app]",
      "name = acme-service",
      "version = 1.4.0",
      "environment = production",
      "debug = false",
      "workers = 4"
    ]
  },

  "server_config": {
    "prefix": ["serverconfig", "server"],
    "description": "INI section with the http server settings",
    "body": [
      "[server]",
      "host = 0.0.0.0",
      "port = 8080",
      "tls = true",
      "cert_file = /etc/ssl/acme.crt",
      "key_file = /etc/ssl/acme.key",
      "client_max_body_size = 16M"
    ]
  },

  "database_config": {
    "prefix": ["dbconfig", "database"],
    "description": "INI section with the database connection settings",
    "body": [
      "[database]",
      "host = localhost",
      "port = 5432",
      "name = acme",
      "user = acme",
      "password = secret",
      "pool_min = 2",
      "pool_max = 10"
    ]
  },

  "logging_config": {
    "prefix": ["logconfig", "logging"],
    "description": "INI section with the logging settings",
    "body": [
      "[log]",
      "level = info",
      "format = json",
      "file = /var/log/acme/service.log",
      "max_size = 100MB",
      "max_files = 5"
    ]
  },

  "plugin_config": {
    "prefix": ["pluginconfig", "plugins"],
    "description": "INI sections configuring plugins and their options",
    "body": [
      "[plugins]",
      "enabled = metrics,tracing",
      "metrics_export_interval = 15",
      "tracing_sample_rate = 0.1",
      "",
      "[plugins.sentry]",
      "dsn = https://examplePublicKey@o0.ingest.sentry.io/0",
      "sample_rate = 0.25"
    ]
  },

  "environment_variable": {
    "prefix": ["envvar", "env"],
    "description": "INI value substituted from an environment variable",
    "body": [
      "[service]",
      "host = \\${HOST}",
      "port = \\${PORT}",
      "api_url = \\${API_BASE_URL}/v1"
    ]
  },

  "typed_values": {
    "prefix": ["typedvals", "values"],
    "description": "INI values that are booleans or numbers",
    "body": [
      "[settings]",
      "enabled = true",
      "disabled = false",
      "retries = 3",
      "timeout = 30",
      "ratio = 0.75"
    ]
  },

  "portable_config": {
    "prefix": ["portable", "portablecfg"],
    "description": "INI file using relative paths that work on every platform",
    "body": [
      "[paths]",
      "root = .",
      "data_dir = data",
      "cache_dir = .cache",
      "log_dir = logs",
      "",
      "[network]",
      "proxy =",
      "timeout = 30"
    ]
  },

  "desktop_entry": {
    "prefix": ["desktop", "desktopentry"],
    "description": "Freedesktop desktop entry file for an application",
    "body": [
      "[Desktop Entry]",
      "Type = Application",
      "Name = Acme Service",
      "Comment = Internal order processing service",
      "Exec = /usr/bin/acme-service --foreground",
      "Icon = acme-service",
      "Terminal = false",
      "Categories = Utility;Development;"
    ]
  }
}
