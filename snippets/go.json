  "go_error_wrap": {
    "prefix": ["errwrap"],
    "description": "Helper that wraps an error with an operation name",
    "body": [
      "var ErrNotFound = errors.New(\"not found\")",
      "",
      "func wrapError(op string, err error) error {",
      "\tif err == nil {",
      "\t\treturn nil",
      "\t}",
      "\treturn fmt.Errorf(\"${1:operation}: %w\", op, err)",
      "}",
      "",
      "func getOrder(id string) (Order, error) {",
      "\torder, err := orders.Get(id)",
      "\tif errors.Is(err, sql.ErrNoRows) {",
      "\t\treturn Order{}, ErrNotFound",
      "\t}",
      "\tif err != nil {",
      "\t\treturn Order{}, wrapError(\"get order\", err)",
      "\t}",
      "\treturn order, nil",
      "}"
    ]
  },

  "go_goroutine_channel": {
    "prefix": ["goroutine"],
    "description": "Fan out work over goroutines and collect results by channel",
    "body": [
      "func processAll(ctx context.Context, items []Item) []Result {",
      "\tresults := make(chan Result, len(items))",
      "\tvar wg sync.WaitGroup",
      "",
      "\tfor _, item := range items {",
      "\t\twg.Add(1)",
      "\t\tgo func(item Item) {",
      "\t\t\tdefer wg.Done()",
      "\t\t\tvalue, err := process(ctx, item)",
      "\t\t\tresults <- Result{Value: value, Err: err}",
      "\t\t}(item)",
      "\t}",
      "",
      "\twg.Wait()",
      "\tclose(results)",
      "",
      "\tout := make([]Result, 0, len(items))",
      "\tfor res := range results {",
      "\t\tif res.Err != nil {",
      "\t\t\tlog.Printf(\"process failed: %v\", res.Err)",
      "\t\t\tcontinue",
      "\t\t}",
      "\t\tout = append(out, res)",
      "\t}",
      "\treturn out",
      "}"
    ]
  },

  "go_context_timeout": {
    "prefix": ["ctx"],
    "description": "Context with timeout plus cancellation of the request",
    "body": [
      "func fetchJSON(ctx context.Context, client *http.Client, url string) ([]byte, error) {",
      "\tctx, cancel := context.WithTimeout(ctx, 5*time.Second)",
      "\tdefer cancel()",
      "",
      "\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)",
      "\tif err != nil {",
      "\t\treturn nil, fmt.Errorf(\"build request: %w\", err)",
      "\t}",
      "",
      "\tres, err := client.Do(req)",
      "\tif err != nil {",
      "\t\treturn nil, fmt.Errorf(\"call %s: %w\", url, err)",
      "\t}",
      "\tdefer res.Body.Close()",
      "",
      "\treturn io.ReadAll(res.Body)",
      "}"
    ]
  },

  "go_table_test": {
    "prefix": ["testtable"],
    "description": "Table driven unit test with subtests per case",
    "body": [
      "func TestFormatDuration(t *testing.T) {",
      "\ttests := []struct {",
      "\t\tname string",
      "\t\tin   time.Duration",
      "\t\twant string",
      "\t}{",
      "\t\t{name: \"minutes\", in: 90 * time.Second, want: \"1m30s\"},",
      "\t\t{name: \"zero\", in: 0, want: \"0s\"},",
      "\t}",
      "",
      "\tfor _, tt := range tests {",
      "\t\tt.Run(tt.name, func(t *testing.T) {",
      "\t\t\tif got := FormatDuration(tt.in); got != tt.want {",
      "\t\t\t\tt.Errorf(\"FormatDuration(%v) = %q, want %q\", tt.in, got, tt.want)",
      "\t\t\t}",
      "\t\t})",
      "\t}",
      "}"
    ]
  },

  "go_defer_cleanup": {
    "prefix": ["deferclose"],
    "description": "Open a resource, defer its cleanup and handle stat errors",
    "body": [
      "func readConfig(path string) ([]byte, error) {",
      "\tfile, err := os.Open(path)",
      "\tif err != nil {",
      "\t\treturn nil, fmt.Errorf(\"open %s: %w\", path, err)",
      "\t}",
      "\tdefer file.Close()",
      "",
      "\tinfo, err := file.Stat()",
      "\tif err != nil {",
      "\t\treturn nil, fmt.Errorf(\"stat %s: %w\", path, err)",
      "\t}",
      "\tif info.IsDir() {",
      "\t\treturn nil, fmt.Errorf(\"%s is a directory\", path)",
      "\t}",
      "",
      "\treturn io.ReadAll(file)",
      "}"
    ]
  },

