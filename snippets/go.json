  "go_generic_helper": {
    "prefix": ["generic"],
    "description": "Generic slice helpers that map and filter every element",
    "body": [
      "func Map[T any, U any](items []T, fn func(T) U) []U {",
      "\tout := make([]U, 0, len(items))",
      "\tfor _, item := range items {",
      "\t\tout = append(out, fn(item))",
      "\t}",
      "\treturn out",
      "}",
      "",
      "func Filter[T any](items []T, keep func(T) bool) []T {",
      "\tout := make([]T, 0, len(items))",
      "\tfor _, item := range items {",
      "\t\tif keep(item) {",
      "\t\t\tout = append(out, item)",
      "\t\t}",
      "\t}",
      "\treturn out",
      "}"
    ]
  },

  "go_select_loop": {
    "prefix": ["selectloop"],
    "description": "Select loop that reacts to jobs, a ticker and cancellation",
    "body": [
      "func consume(ctx context.Context, jobs <-chan Job, results chan<- Result, ticker *time.Ticker) error {",
      "\tfor {",
      "\t\tselect {",
      "\t\tcase <-ctx.Done():",
      "\t\t\treturn ctx.Err()",
      "\t\tcase job := <-jobs:",
      "\t\t\tresult, err := handle(job)",
      "\t\t\tif err != nil {",
      "\t\t\t\tlog.Printf(\"job failed: %v\", err)",
      "\t\t\t\tcontinue",
      "\t\t\t}",
      "\t\t\tresults <- result",
      "\t\tcase <-ticker.C:",
      "\t\t\tlog.Println(\"still working\")",
      "\t\t}",
      "\t}",
      "}"
    ]
  },

  "go_mutex_counter": {
    "prefix": ["mutexcounter"],
    "description": "Counter guarded by a mutex with getter and incrementer",
    "body": [
      "type Counter struct {",
      "\tmu sync.Mutex",
      "\tn  int64",
      "}",
      "",
      "func (c *Counter) Inc() int64 {",
      "\tc.mu.Lock()",
      "\tdefer c.mu.Unlock()",
      "\tc.n++",
      "\treturn c.n",
      "}",
      "",
      "func (c *Counter) Value() int64 {",
      "\tc.mu.Lock()",
      "\tdefer c.mu.Unlock()",
      "\treturn c.n",
      "}"
    ]
  },

  "go_retry_client": {
    "prefix": ["retry"],
    "description": "HTTP client that retries with a growing backoff delay",
    "body": [
      "func (c *Client) Get(ctx context.Context, url string) (*http.Response, error) {",
      "\tvar lastErr error",
      "",
      "\tfor attempt := 1; attempt <= c.maxRetries; attempt++ {",
      "\t\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)",
      "\t\tif err != nil {",
      "\t\t\treturn nil, fmt.Errorf(\"build request: %w\", err)",
      "\t\t}",
      "",
      "\t\tres, err := c.http.Do(req)",
      "\t\tif err == nil {",
      "\t\t\treturn res, nil",
      "\t\t}",
      "\t\tlastErr = err",
      "",
      "\t\tdelay := time.Duration(attempt) * c.backoff",
      "\t\tselect {",
      "\t\tcase <-ctx.Done():",
      "\t\t\treturn nil, ctx.Err()",
      "\t\tcase <-time.After(delay):",
      "\t\t}",
      "\t}",
      "",
      "\treturn nil, fmt.Errorf(\"get %s after %d attempts: %w\", url, c.maxRetries, lastErr)",
      "}"
    ]
  },

  "go_slice_helper": {
    "prefix": ["sliceutil"],
    "description": "Generic slice helpers to filter and to split into chunks",
    "body": [
      "func Filter[T any](items []T, keep func(T) bool) []T {",
      "\tout := make([]T, 0, len(items))",
      "\tfor _, item := range items {",
      "\t\tif keep(item) {",
      "\t\t\tout = append(out, item)",
      "\t\t}",
      "\t}",
      "\treturn out",
      "}",
      "",
      "func Chunk[T any](items []T, size int) [][]T {",
      "\tif size <= 0 {",
      "\t\tpanic(\"chunk size must be positive\")",
      "\t}",
      "",
      "\tchunks := make([][]T, 0, (len(items)+size-1)/size)",
      "\tfor start := 0; start < len(items); start += size {",
      "\t\tend := start + size",
      "\t\tif end > len(items) {",
      "\t\t\tend = len(items)",
      "\t\t}",
      "\t\tchunks = append(chunks, items[start:end])",
      "\t}",
      "\treturn chunks",
      "}"
    ]
  },

  "go_map_iteration": {
    "prefix": ["maprange"],
    "description": "Count words in a map and iterate over the keys in order",
    "body": [
      "func wordCounts(words []string) map[string]int {",
      "\tcounts := map[string]int{}",
      "\tfor _, word := range words {",
      "\t\tcounts[word]++",
      "\t}",
      "\treturn counts",
      "}",
      "",
      "func sortedKeys(counts map[string]int) []string {",
      "\tkeys := make([]string, 0, len(counts))",
      "\tfor key := range counts {",
      "\t\tkeys = append(keys, key)",
      "\t}",
      "\tsort.Strings(keys)",
      "\treturn keys",
      "}"
    ]
  },

  "go_file_io": {
    "prefix": ["fileio"],
    "description": "Read a file into memory and write it back with permissions",
    "body": [
      "func loadFile(path string) ([]byte, error) {",
      "\tdata, err := os.ReadFile(path)",
      "\tif err != nil {",
      "\t\treturn nil, fmt.Errorf(\"read %s: %w\", path, err)",
      "\t}",
      "\treturn data, nil",
      "}",
      "",
      "func saveFile(path string, data []byte) error {",
      "\tif err := os.WriteFile(path, data, 0o644); err != nil {",
      "\t\treturn fmt.Errorf(\"write %s: %w\", path, err)",
      "\t}",
      "\tlog.Printf(\"wrote %d bytes to %s\", len(data), path)",
      "\treturn nil",
      "}"
    ]
  },

  "go_flag_parse": {
    "prefix": ["flagparse"],
    "description": "Parse command line flags into typed variables",
    "body": [
      "func parseFlags() (*Config, error) {",
      "\tvar (",
      "\t\tconfigPath = flag.String(\"config\", \"config.yaml\", \"path to the config file\")",
      "\t\tverbose    = flag.Bool(\"verbose\", false, \"enable verbose logging\")",
      "\t\ttimeout    = flag.Duration(\"timeout\", 30*time.Second, \"request timeout\")",
      "\t)",
      "",
      "\tflag.Parse()",
      "",
      "\tif *verbose {",
      "\t\tlog.SetOutput(os.Stdout)",
      "\t}",
      "",
      "\treturn &Config{Path: *configPath, Verbose: *verbose, Timeout: *timeout}, nil",
      "}"
    ]
  },

  "go_worker_pool": {
    "prefix": ["workerpool"],
    "description": "Worker pool that processes jobs on several goroutines",
    "body": [
      "func runPool(tasks []Task, workers int) []Result {",
      "\tjobs := make(chan Task, len(tasks))",
      "\tresults := make(chan Result, len(tasks))",
      "",
      "\tvar wg sync.WaitGroup",
      "\tfor i := 0; i < workers; i++ {",
      "\t\twg.Add(1)",
      "\t\tgo func() {",
      "\t\t\tdefer wg.Done()",
      "\t\t\tfor job := range jobs {",
      "\t\t\t\tresults <- runJob(job)",
      "\t\t\t}",
      "\t\t}()",
      "\t}",
      "",
      "\tfor _, task := range tasks {",
      "\t\tjobs <- task",
      "\t}",
      "\tclose(jobs)",
      "",
      "\twg.Wait()",
      "\tclose(results)",
      "",
      "\tout := make([]Result, 0, len(tasks))",
      "\tfor res := range results {",
      "\t\tout = append(out, res)",
      "\t}",
      "\treturn out",
      "}"
    ]
  },

  "go_ticker": {
    "prefix": ["ticker"],
    "description": "Periodic refresh with a ticker that is always stopped",
    "body": [
      "func refreshLoop(ctx context.Context, every time.Duration) error {",
      "\tticker := time.NewTicker(every)",
      "\tdefer ticker.Stop()",
      "",
      "\tfor {",
      "\t\tselect {",
      "\t\tcase <-ticker.C:",
      "\t\t\tif err := refreshCache(); err != nil {",
      "\t\t\t\tlog.Printf(\"refresh cache: %v\", err)",
      "\t\t\t}",
      "\t\tcase <-ctx.Done():",
      "\t\t\treturn ctx.Err()",
      "\t\t}",
      "\t}",
      "}"
    ]
  },

  "go_http_request": {
    "prefix": ["httpreq"],
    "description": "HTTP GET request that checks the status and decodes JSON",
    "body": [
      "func getUser(ctx context.Context, client *http.Client, url string) (User, error) {",
      "\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)",
      "\tif err != nil {",
      "\t\treturn User{}, fmt.Errorf(\"create request: %w\", err)",
      "\t}",
      "\treq.Header.Set(\"Accept\", \"application/json\")",
      "",
      "\tres, err := client.Do(req)",
      "\tif err != nil {",
      "\t\treturn User{}, fmt.Errorf(\"send request: %w\", err)",
      "\t}",
      "\tdefer res.Body.Close()",
      "",
      "\tif res.StatusCode != http.StatusOK {",
      "\t\treturn User{}, fmt.Errorf(\"unexpected status: %s\", res.Status)",
      "\t}",
      "",
      "\tvar payload User",
      "\tif err := json.NewDecoder(res.Body).Decode(&payload); err != nil {",
      "\t\treturn User{}, fmt.Errorf(\"decode body: %w\", err)",
      "\t}",
      "\treturn payload, nil",
      "}"
    ]
  },

  "go_http_json_handler": {
    "prefix": ["httphandler"],
    "description": "HTTP handler that encodes JSON and maps errors to status",
    "body": [
      "func getUser(w http.ResponseWriter, r *http.Request) {",
      "\tid := r.PathValue(\"id\")",
      "",
      "\tuser, err := store.GetUser(r.Context(), id)",
      "\tif err != nil {",
      "\t\thttp.Error(w, \"user not found\", http.StatusNotFound)",
      "\t\treturn",
      "\t}",
      "",
      "\tw.Header().Set(\"Content-Type\", \"application/json\")",
      "\tif err := json.NewEncoder(w).Encode(user); err != nil {",
      "\t\tlog.Printf(\"encode user %s: %v\", id, err)",
      "\t}",
      "}"
    ]
  }
}
