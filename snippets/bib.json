  "month_macro": {
    "prefix": ["monthmac"],
    "description": "Month macros defined as strings and used in an entry",
    "body": [
      "@string{jan = \"January\"}",
      "@string{feb = \"February\"}",
      "@string{mar = \"March\"}",
      "",
      "@article{${1:smith2024},",
      "  title  = {${2:Title of the article}},",
      "  month  = jan,",
      "  year   = {2024}",
      "}"
    ]
  },

  "string_macro": {
    "prefix": ["stringmac"],
    "description": "Reusable string macros for journal names and publishers",
    "body": [
      "@string{jfp = \"Journal of Functional Programming\"}",
      "@string{tcs = \"Theoretical Computer Science\"}",
      "",
      "@article{${1:smith2024programs},",
      "  title   = {${2:Bidirectional Type Checking}},",
