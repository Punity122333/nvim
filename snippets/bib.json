{
  "article_entry": {
    "prefix": ["article"],
    "description": "Journal article with volume, pages, doi and keywords",
    "body": [
      "@article{${1:smith2024attention},",
      "  title    = {${2:Attention Is Still All You Need}},",
      "  author   = {${3:Jane Smith and Alex Doe}},",
      "  journal  = {Journal of Machine Learning Research},",
      "  year     = {2024},",
